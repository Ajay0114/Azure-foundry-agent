# Copy this file to .env (git-ignored) and fill in the blanks. Never commit real secrets.

# --- Microsoft Foundry ---
# Foundry injects FOUNDRY_PROJECT_ENDPOINT when the agent is hosted; set it here only for local runs.
FOUNDRY_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=

# --- OneSpaWorld vessel and itinerary APIs ---
OSW_TOKEN_URL=
OSW_CLIENT_ID=
OSW_CLIENT_SECRET=
OSW_VESSELS_SCOPE=
OSW_ITINERARY_SCOPE=
# OSW_BASE_URL=https://oswbus-dev.onespaworld.com

# --- Zendesk SANDBOX (ids from "Sandbox Zendesk Field Mapping Sheet", OSW Form) ---
# Fill in these two. The authorization is the value after "Basic " (base64 of "email/token:api_token"),
# or leave it blank and set ZENDESK_EMAIL and ZENDESK_API_TOKEN instead.
ZENDESK_BASE_URL=
ZENDESK_AUTHORIZATION=
# ZENDESK_EMAIL=
# ZENDESK_API_TOKEN=

ZENDESK_FORM_ID=38659248180887                  # OSW Form
ZENDESK_BRAND_ID=37514446378007                 # One Spa World
ZENDESK_RETURN_GROUP_ID=41169307571607          # Return Forms SM (only for product returns)

ZENDESK_FIELD_CREATED_BY=38155684059543         # Created By (chatbot)
ZENDESK_FIELD_PRIORITY=37514390419863           # Priority (urgent)
ZENDESK_FIELD_INQUIRY_TYPE=37514448060311       # Inquiry Type (osw_product_return)
ZENDESK_FIELD_CATEGORY=38659478631319           # category (osw_onboard_purchase / osw_home_delivery_hd)
ZENDESK_FIELD_CRUISE_LINE=37514463533719        # Cruise Line (text)
ZENDESK_FIELD_CRUISE_SHIP=37514447550231        # Cruise Ship (text)
ZENDESK_FIELD_SAIL_DATE=37514441675159          # Sail Date (YYYY-MM-DD)
ZENDESK_FIELD_PRODUCT_REASON=38659352020759     # Product Reason
ZENDESK_FIELD_RETURN_STATUS=37514478688919      # Return Status (osw_return_requested)
# ZENDESK_TAGS=kore_ai,tag_website              # optional; this is the default (what Kore sent)

# --- Attachment service (Azure Function: scans the customer's file, stages it in Zendesk) ---
ATTACHMENT_API_URL=
ATTACHMENT_API_KEY=

# --- Document creation API (returns and transactions documents) ---
DOCUMENT_API_URL=
DOCUMENT_CLIENT_ID=
DOCUMENT_CLIENT_SECRET=
DOCUMENT_RETURNS_SCOPE=
DOCUMENT_TRANSACTIONS_SCOPE=
# DOCUMENT_TOKEN_URL=                           # defaults to OSW_TOKEN_URL (same tenant)

# --- Conversation state ---
# Local runs keep state in files (MARINA_STATE_DIR). In Foundry set the two lines below instead: the agent reads and
# writes blobs with its own identity (no key). The container must already exist.
# STATE_BLOB_ACCOUNT_URL=https://oswdevpoc.blob.core.windows.net
# STATE_BLOB_CONTAINER=marina-state-ai-foundry
# Stopgap while the role is pending: the account's connection string (a master key for the whole account; sandbox only,
# rotate the key afterwards). When set it is used instead of the identity. Keep the quotes: it contains ; and =.
# STATE_BLOB_CONNECTION_STRING=""

# --- Document-event callback (the marina-callback agent; callback_main.py) ---
# OneSpaWorld's document service sends events; the callback updates the ticket. It also uses the ZENDESK_* and OSW_* settings above.
# The Azure Function that turns a document id into a Zendesk upload token (Kore's AzureGetUploadToken step). This is NOT the
# ATTACHMENT_API_* function above (that one scans customers' files); its key is a secret.
CALLBACK_UPLOAD_API_URL=
CALLBACK_UPLOAD_API_KEY=
# Id of the Zendesk ticket field that holds the vessel's SPA manager e-mail (set on DocumentsSearchDelegated events).
ZENDESK_FIELD_SPA_MANAGER_EMAIL=
# The retry queue for events that failed twice (Azure Function, the key is a secret). Without it a failed event is only reported.
REDRIVE_API_URL=
REDRIVE_API_KEY=
# true: answer with the outcome after the ticket work is done, instead of acknowledging at once (for testing from Postman).
# CALLBACK_WAIT_FOR_RESULT=false
# Test environments only: use this address instead of the vessel record's SPA manager e-mail.
# CALLBACK_SPA_MANAGER_EMAIL_OVERRIDE=

# --- Execution trace for the developer page (optional, development and test only) ---
# true: each message also records the steps the bot ran (node transitions, model and API calls with timings, variable
# changes) in the saved state, for the debug panel at http://localhost:8000/dev (start ui.py with UI_DEBUG=true).
# The trace holds what customers typed: keep it false in production. Default false.
# DEBUG_TRACE=false

# --- Conversation transcript (optional) ---
# The whole conversation is also written as a CSV in Kore's transcript layout, next to the state:
# transcripts/<yyyy-mm-dd>/<conversation>.csv, rewritten after every message. Names, e-mails and phone numbers
# are masked by default. To change these when hosted, add the variable to azure.yaml as well.
# TRANSCRIPT_ENABLED=true
# TRANSCRIPT_MASK_PII=true
# TRANSCRIPT_BOT_NAME=Marina
# TRANSCRIPT_CHANNEL=Foundry

# --- Optional ---
# MARINA_STATE_DIR=~/marina_state
